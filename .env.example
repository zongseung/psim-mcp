# Copy this file to .env and adjust it for your installation.

# Use "real" to run an installed copy of PSIM. Use "mock" when PSIM is unavailable.
PSIM_MODE=real

# Required in real mode.
PSIM_PATH=C:\Altair\Altair_PSIM_2026
PSIM_PYTHON_EXE=C:\Users\<사용자>\AppData\Local\Programs\Python\Python39\python.exe

# Simulation output directory.
PSIM_OUTPUT_DIR=./output

# Logging.
LOG_DIR=./logs
LOG_LEVEL=INFO

# MCP transport: stdio for Claude Desktop, or sse.
SERVER_TRANSPORT=stdio
# Used only when SERVER_TRANSPORT=sse.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Simulation limits.
SIMULATION_TIMEOUT=300
MAX_SWEEP_STEPS=100

# Optional comma-separated absolute project directories. When omitted, any
# validator-accepted absolute project path is allowed.
# ALLOWED_PROJECT_DIRS=C:\circuits,C:\projects
